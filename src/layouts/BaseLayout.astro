---
import '../styles/global.css';
import Intro from '../components/Intro.astro';
import Ambient from '../components/Ambient.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Murdo's blog" } = Astro.props;
const siteName = 'MUR DOS LOG';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    {/* 首帧前判定：开场播放状态 + 明暗主题，避免闪烁 */}
    <script is:inline>
      (function () {
        var seen = sessionStorage.getItem('introPlayed') === '1';
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var force = location.hash === '#intro';
        // 减少动态偏好的用户视为"已看过"：不播开场，工具栏/滚动不受限
        var play = (!seen || force) && !reduced;
        document.documentElement.classList.add(play ? 'intro-on' : 'intro-seen');
        if (reduced) document.documentElement.classList.add('intro-reduced');

        var theme = localStorage.getItem('theme');
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="toolbar" role="group" aria-label="settings">
      <button id="themeToggle" type="button" aria-label="切换明暗主题">
        <svg class="icon-moon" viewBox="0 0 24 24"><path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
      </button>
    </div>

    <div class="page">
      <header class="site-header">
        <a href="/"><span class="site-name">MUR DOS LOG</span></a>
        <p class="site-tagline">Murdo's blog</p>
        <img class="header-chara sketch" src="/assets/chara/chara-ai.webp" alt="" loading="lazy" draggable="false" />
      </header>

      <main>
        <slot />
      </main>

      {/* 范畴论签名：思想→工具→世界 = 思想→随笔→世界，此图交换 */}
      <div class="math-sig" aria-hidden="true">
        <svg viewBox="0 0 240 96" width="240" height="96">
          <defs>
            <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 1 L 9 5 L 0 9 z" />
            </marker>
          </defs>
          <text x="24" y="24" text-anchor="middle">思想</text>
          <text x="216" y="24" text-anchor="middle">工具</text>
          <text x="24" y="84" text-anchor="middle">随笔</text>
          <text x="216" y="84" text-anchor="middle">世界</text>
          <line x1="44" y1="20" x2="196" y2="20" marker-end="url(#arr)" />
          <line x1="44" y1="80" x2="196" y2="80" marker-end="url(#arr)" />
          <line x1="24" y1="32" x2="24" y2="72" marker-end="url(#arr)" />
          <line x1="216" y1="32" x2="216" y2="72" marker-end="url(#arr)" />
          <text x="120" y="14" text-anchor="middle" class="sig-edge">铸造</text>
          <text x="120" y="94" text-anchor="middle" class="sig-edge">被阅读</text>
          <text x="14" y="56" text-anchor="middle" class="sig-edge" transform="rotate(-90 14 56)">写下</text>
          <text x="228" y="56" text-anchor="middle" class="sig-edge" transform="rotate(-90 228 56)">使用</text>
        </svg>
        <p class="sig-caption">此图交换 · in the category of Murdo</p>
      </div>

      <footer class="site-footer">
        <span>© {year}</span>
        <a href="/rss.xml">RSS</a>
        <a id="replayIntro" role="button" tabindex="0">重播开场</a>
        <span class="spacer"></span>
        {/* TODO: 备案通过后改为 <a href="https://beian.miit.gov.cn" target="_blank" rel="noopener">京ICP备XXXXXXXX号</a> */}
        <a class="beian" href="https://beian.miit.gov.cn" target="_blank" rel="noopener"></a>
        <img class="footer-figure" src="/assets/figure-cut-ink.webp" alt="" loading="lazy" draggable="false" />
      </footer>
    </div>

    <Ambient />
    <Intro />

    <script>
      const root = document.documentElement;

      document.getElementById('themeToggle')?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      const replay = document.getElementById('replayIntro');
      replay?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('intro:replay'));
      });
      replay?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('intro:replay'));
        }
      });

      // Konami 秘籍：↑↑↓↓←→←→BA → 星尘爆发
      const KONAMI = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
      let kIdx = 0;
      window.addEventListener('keydown', (e) => {
        kIdx = e.key === KONAMI[kIdx] || (KONAMI[kIdx] === 'b' && e.key === 'b') || (KONAMI[kIdx] === 'a' && e.key === 'a')
          ? kIdx + 1
          : (e.key === KONAMI[0] ? 1 : 0);
        if (kIdx === KONAMI.length) {
          kIdx = 0;
          document.dispatchEvent(new CustomEvent('konami'));
          const toast = document.querySelector('.konami-toast');
          if (toast) {
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2200);
          }
        }
      });
    </script>

    <div class="konami-toast" role="status">✦ KONAMI ✦ 星尘爆发</div>
  </body>
</html>
