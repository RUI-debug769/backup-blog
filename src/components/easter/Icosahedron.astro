---
/**
 * 首页数学角：正二十面体旋转线框 —— I ≅ A₅ ↪ SO(3)，|A₅| = 60
 * 移植自旧站 index.astro：30fps 封顶 + IntersectionObserver 离屏暂停 +
 * reduced-motion（系统偏好或 html.motion-reduced）不启动；
 * intro 播放期间冻结；颜色读 --primary。
 * Swup 切页会重建容器内 canvas，故监听 swup:content:replace 重新初始化。
 */
---

<section class="math-corner" aria-hidden="true">
	<canvas id="icoCanvas" width="150" height="150"></canvas>
	<p class="math-caption">I ≅ A₅ ↪ SO(3) · |A₅| = 60</p>
</section>

<script>
	function initIcosahedron() {
		const ico = document.getElementById(
			"icoCanvas",
		) as HTMLCanvasElement | null;
		if (!ico || ico.dataset.inited === "1") return;
		ico.dataset.inited = "1";

		const reduced =
			window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
			document.documentElement.classList.contains("motion-reduced");
		if (reduced) return;

		const ctx = ico.getContext("2d")!;
		const S = 150;
		ico.width = S;
		ico.height = S;
		const PHI = (1 + Math.sqrt(5)) / 2;
		const V: number[][] = [];
		for (const a of [-1, 1])
			for (const b of [-1, 1]) {
				V.push([a, b * PHI, 0], [0, a, b * PHI], [a * PHI, 0, b]);
			}
		const norm = Math.sqrt(1 + PHI * PHI);
		V.forEach((v) => {
			v[0] /= norm;
			v[1] /= norm;
			v[2] /= norm;
		});
		const E: [number, number][] = [];
		for (let i = 0; i < 12; i++)
			for (let j = i + 1; j < 12; j++) {
				const d = Math.hypot(
					V[i][0] - V[j][0],
					V[i][1] - V[j][1],
					V[i][2] - V[j][2],
				);
				if (d < 1.1) E.push([i, j]);
			}

		let running = false;
		let last = 0;
		let rot = 0.4;

		function accent() {
			return (
				getComputedStyle(document.documentElement)
					.getPropertyValue("--primary")
					.trim() || "#8b9bff"
			);
		}

		function frame(now: number) {
			if (!running) return;
			requestAnimationFrame(frame);
			if (window.__introPlayed === true) {
				last = now;
				return;
			}
			if (now - last < 33) return; // 30fps 封顶
			last = now;
			rot += 0.006;
			const cy = Math.cos(rot);
			const sy = Math.sin(rot);
			const cx = Math.cos(rot * 0.37);
			const sx = Math.sin(rot * 0.37);
			const P = V.map(([x, y, z]) => {
				const x1 = x * cy + z * sy;
				const z1 = -x * sy + z * cy;
				const y2 = y * cx - z1 * sx;
				const z2 = y * sx + z1 * cx;
				return [S / 2 + x1 * 52, S / 2 + y2 * 52, z2];
			});
			ctx.clearRect(0, 0, S, S);
			const color = accent();
			for (const [i, j] of E) {
				const depth = (P[i][2] + P[j][2]) / 2;
				ctx.globalAlpha = 0.18 + (0.4 * (depth + 1)) / 2;
				ctx.strokeStyle = color;
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.moveTo(P[i][0], P[i][1]);
				ctx.lineTo(P[j][0], P[j][1]);
				ctx.stroke();
			}
			ctx.fillStyle = color;
			for (const p of P) {
				ctx.globalAlpha = 0.35 + (0.5 * (p[2] + 1)) / 2;
				ctx.fillRect(p[0] - 1.5, p[1] - 1.5, 3, 3);
			}
			ctx.globalAlpha = 1;
		}

		new IntersectionObserver((entries) => {
			const vis = entries[0].isIntersecting;
			if (vis && !running) {
				running = true;
				last = 0;
				requestAnimationFrame(frame);
			}
			if (!vis) running = false;
		}).observe(ico);
	}

	initIcosahedron();
	document.addEventListener("swup:content:replace", () => {
		requestAnimationFrame(initIcosahedron);
	});
</script>
