---
/**
 * Konami 秘籍：↑↑↓↓←→←→BA
 * dispatch document 级 'konami' CustomEvent：
 *   - GrayScott.astro 监听 → 斑图播种
 *   - 本组件 → 星尘爆发（短暂全屏 canvas，粒子色读 --primary / --on-surface）
 * 挂在 Layout（Swup 容器外），监听只绑一次；reduced-motion 下只播种不爆发。
 */
---

<canvas
	id="konamiBurstCanvas"
	class="fixed inset-0 pointer-events-none"
	style="z-index: 50; opacity: 0"
	aria-hidden="true"
></canvas>
<div class="konami-toast" role="status">✦ KONAMI ✦ 星尘爆发</div>

<script>
	function initKonami() {
		if (window.__konamiBound) return;
		window.__konamiBound = true;

		const KONAMI = [
			"ArrowUp",
			"ArrowUp",
			"ArrowDown",
			"ArrowDown",
			"ArrowLeft",
			"ArrowRight",
			"ArrowLeft",
			"ArrowRight",
			"b",
			"a",
		];
		let kIdx = 0;
		let bursting = false; // 爆发进行中：连发秘籍直接忽略，防双 rAF
		window.addEventListener("keydown", (e) => {
			const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
			kIdx =
				key === KONAMI[kIdx]
					? kIdx + 1
					: key === KONAMI[0]
						? 1
						: 0;
			if (kIdx !== KONAMI.length) return;
			kIdx = 0;
			if (bursting) return;
			document.dispatchEvent(new CustomEvent("konami"));
			const toast = document.querySelector(".konami-toast");
			if (toast) {
				toast.classList.add("show");
				window.setTimeout(() => toast.classList.remove("show"), 2200);
			}
			starBurst();
		});

		// ---- 星尘爆发（一次性短命 canvas，单 rAF，约 2.4s 自停） ----
		const reduced =
			window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
			document.documentElement.classList.contains("motion-reduced");

		function cssColor(name: string, fallback: string) {
			const v = getComputedStyle(document.documentElement)
				.getPropertyValue(name)
				.trim();
			return v || fallback;
		}

		function starBurst() {
			if (reduced) return;
			const canvas = document.getElementById(
				"konamiBurstCanvas",
			) as HTMLCanvasElement | null;
			if (!canvas) return;
			bursting = true;
			const cv: HTMLCanvasElement = canvas;
			const ctx = cv.getContext("2d")!;
			const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			const w = window.innerWidth;
			const h = window.innerHeight;
			cv.width = Math.round(w * dpr);
			cv.height = Math.round(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			const colors = [
				cssColor("--primary", "#8b9bff"),
				cssColor("--on-surface", "#e6ebff"),
				cssColor("--tertiary", cssColor("--primary", "#8b9bff")),
			];
			interface P {
				x: number;
				y: number;
				vx: number;
				vy: number;
				life: number;
				size: number;
				color: string;
			}
			const parts: P[] = [];
			for (let i = 0; i < 240; i++) {
				const ang = Math.random() * Math.PI * 2;
				const sp = 1.5 + Math.random() * 6;
				parts.push({
					x: w / 2,
					y: h * 0.4,
					vx: Math.cos(ang) * sp,
					vy: Math.sin(ang) * sp - 0.8,
					life: 1,
					size: 1.5 + Math.random() * 2.5,
					color: colors[Math.floor(Math.random() * colors.length)],
				});
			}

			cv.style.opacity = "1";
			let last = performance.now();
			function frame(now: number) {
				const dt = Math.min((now - last) / 16.67, 3) || 1;
				last = now;
				ctx.clearRect(0, 0, w, h);
				let alive = false;
				for (const p of parts) {
					if (p.life <= 0) continue;
					alive = true;
					p.x += p.vx * dt;
					p.y += p.vy * dt;
					p.vy += 0.06 * dt;
					p.life -= 0.012 * dt;
					ctx.globalAlpha = Math.max(p.life, 0);
					ctx.fillStyle = p.color;
					ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
				}
				ctx.globalAlpha = 1;
				if (alive) requestAnimationFrame(frame);
				else {
					ctx.clearRect(0, 0, w, h);
					cv.style.opacity = "0";
					bursting = false;
				}
			}
			requestAnimationFrame(frame);
		}
	}

	initKonami();
</script>
