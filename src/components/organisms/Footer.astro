---
/**
 * 页脚（消费 blog/FooterBar 原子）。
 * 只负责配置数据：版权名称/年份、RSS/Atom/Sitemap 链接、Powered by、FooterConfig.html 文件注入。
 * Task 5：雨中少女剪影（旧站墨线素材）坐于页脚右侧 + 范畴论交换图彩蛋。
 */
import * as fs from "node:fs";
import * as path from "node:path";
import FooterBar from "@components/atoms/blog/FooterBar.astro";
import CommutDiagram from "@components/easter/CommutDiagram.astro";
import { url } from "@utils/url-utils";
import { footerConfig, profileConfig } from "@/config";
import packageMetadata from "../../../package.json";

const currentYear = new Date().getFullYear();
const links = [
	{ label: "RSS", href: url("rss/") },
	{ label: "Atom", href: url("atom/") },
	{ label: "Sitemap", href: url("sitemap-index.xml"), external: true },
];
const isShironesPackage = packageMetadata.name === "shirones";
const poweredBy = [
	{ label: "Astro", href: "https://astro.build", external: true },
	{
		label: "Shirone",
		href: "https://github.com/LyraVoid/Shirone",
		external: true,
	},
	...(isShironesPackage
		? [
				{
					label: "shirones",
					href: "https://github.com/yCENzh/shirones",
					external: true,
				},
			]
		: []),
];

let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		// Source mode keeps this next to the other config files in `src/config/`;
		// as an npm package the user's copy lives in the content root instead.
		const footerConfigPath = [
			path.join(process.cwd(), "shirones", "config", "FooterConfig.html"),
			path.join(process.cwd(), "src", "config", "FooterConfig.html"),
		].find((candidate) => fs.existsSync(candidate));
		if (footerConfigPath) {
			const raw = fs.readFileSync(footerConfigPath, "utf-8");
			const cleaned = raw.replace(/<!--[\s\S]*?-->/g, "").trim();
			if (cleaned) {
				customFooterHtml = cleaned;
			}
		}
	} catch {
		customFooterHtml = "";
	}
}
---

<div class="char-footer">
	{/* 雨中少女：坐在页脚分割线上（颜色烘焙在 webp 内，暗色另加紫色微光） */}
	<figure class="char-figure char-footer__figure" aria-hidden="true">
		<img src="/assets/figure-cut-ink.webp" alt="" draggable="false" loading="lazy" />
	</figure>

	<FooterBar
		name={profileConfig.name}
		year={currentYear}
		links={links}
		poweredBy={poweredBy}
		version={packageMetadata.version}
		versionHref={isShironesPackage ? "https://www.npmjs.com/package/shirones" : "https://github.com/LyraVoid/Shirone"}
		customHtml={customFooterHtml}
	/>

	<CommutDiagram />
</div>

<script>
  // GoatCounter 统计：上报访问 + 页脚显示总访问/访客
  // 注意：gc.zgo.at 的 count.js 在国内不可达，这里自己发同样的信标请求
  (function () {
    var w = window;
    if (w.__gcInit) return;
    w.__gcInit = true;

    var ENDPOINT = "https://murdo.goatcounter.com";

    function encode(params) {
      var parts = [];
      for (var k in params) {
        var v = params[k];
        if (v === "" || v === null || v === undefined || v === false) continue;
        parts.push(encodeURIComponent(k) + "=" + encodeURIComponent(v));
      }
      return "?" + parts.join("&");
    }

    // 与 count.js get_data() 一致的 pageview 参数
    function hit() {
      var query = encode({
        p: location.pathname,
        r: document.referrer || undefined,
        t: document.title,
        s: screen.width,
        b: 0,
        q: location.search || undefined,
      });
      var img = new Image(1, 1);
      img.src = ENDPOINT + "/count" + query;
    }

    // 页脚在桌面/移动两套布局里各渲染一次，id 重复，所以填充全部同名节点
    function setAll(id, val) {
      if (val == null) return;
      var nodes = document.querySelectorAll("[id=" + id + "]");
      for (var i = 0; i < nodes.length; i++) nodes[i].textContent = val;
    }

    // GoatCounter 对没有记录的路径返回 404，但响应体仍是同样的 JSON，所以不判 r.ok
    function getJson(url) {
      return fetch(url, { credentials: "omit" })
        .then(function (r) { return r.json(); })
        .catch(function () { return null; });
    }

    function fill() {
      getJson(ENDPOINT + "/counter/TOTAL.json").then(function (d) {
        if (!d) return;
        setAll("busuanzi_value_site_pv", d.count);
        setAll("busuanzi_value_site_uv", d.count_unique);
      });
      getJson(ENDPOINT + "/counter/" + encodeURIComponent(location.pathname) + ".json").then(function (d) {
        if (!d) return;
        setAll("busuanzi_value_page_pv", d.count);
      });
    }

    hit();
    fill();

    // 不依赖 window.load（外部资源挂起时 load 可能长期不触发）
    document.addEventListener("DOMContentLoaded", fill, { once: true });
    window.addEventListener("load", fill, { once: true });
    setTimeout(fill, 1200);

    // Swup 切页：新页面各记一次
    document.addEventListener("swup:page:view", function () {
      hit();
      fill();
    });
  })();
</script>
