---
/**
 * 页脚（消费 blog/FooterBar 原子）。
 * 只负责配置数据：版权名称/年份、RSS/Atom/Sitemap 链接、Powered by、FooterConfig.html 文件注入。
 * Task 5：雨中少女剪影（旧站墨线素材）坐于页脚右侧 + 范畴论交换图彩蛋。
 */
import * as fs from "node:fs";
import * as path from "node:path";
import FooterBar from "@components/atoms/blog/FooterBar.astro";
import CommutDiagram from "@components/easter/CommutDiagram.astro";
import { url } from "@utils/url-utils";
import { footerConfig, profileConfig } from "@/config";
import packageMetadata from "../../../package.json";

const currentYear = new Date().getFullYear();
const links = [
	{ label: "RSS", href: url("rss/") },
	{ label: "Atom", href: url("atom/") },
	{ label: "Sitemap", href: url("sitemap-index.xml"), external: true },
];
const isShironesPackage = packageMetadata.name === "shirones";
const poweredBy = [
	{ label: "Astro", href: "https://astro.build", external: true },
	{
		label: "Shirone",
		href: "https://github.com/LyraVoid/Shirone",
		external: true,
	},
	...(isShironesPackage
		? [
				{
					label: "shirones",
					href: "https://github.com/yCENzh/shirones",
					external: true,
				},
			]
		: []),
];

let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		// Source mode keeps this next to the other config files in `src/config/`;
		// as an npm package the user's copy lives in the content root instead.
		const footerConfigPath = [
			path.join(process.cwd(), "shirones", "config", "FooterConfig.html"),
			path.join(process.cwd(), "src", "config", "FooterConfig.html"),
		].find((candidate) => fs.existsSync(candidate));
		if (footerConfigPath) {
			const raw = fs.readFileSync(footerConfigPath, "utf-8");
			const cleaned = raw.replace(/<!--[\s\S]*?-->/g, "").trim();
			if (cleaned) {
				customFooterHtml = cleaned;
			}
		}
	} catch {
		customFooterHtml = "";
	}
}
---

<div class="char-footer">
	{/* 雨中少女：坐在页脚分割线上（颜色烘焙在 webp 内，暗色另加紫色微光） */}
	<figure class="char-figure char-footer__figure" aria-hidden="true">
		<img src="/assets/figure-cut-ink.webp" alt="" draggable="false" loading="lazy" />
	</figure>

	<FooterBar
		name={profileConfig.name}
		year={currentYear}
		links={links}
		poweredBy={poweredBy}
		version={packageMetadata.version}
		versionHref={isShironesPackage ? "https://www.npmjs.com/package/shirones" : "https://github.com/LyraVoid/Shirone"}
		customHtml={customFooterHtml}
	/>

	<CommutDiagram />
</div>

<script>
  // GoatCounter 访问统计：记录访问 + 页脚显示总访问/访客
  (function () {
    if ((window as any).__gcInit) return;
    (window as any).__gcInit = true;
    var s = document.createElement("script");
    s.async = true;
    s.src = "//gc.zgo.at/count.js";
    s.setAttribute("data-goatcounter", "https://murdo.goatcounter.com/count");
    document.head.appendChild(s);
    function fill() {
      fetch("https://murdo.goatcounter.com/counter/TOTAL.json", { credentials: "omit" })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d) return;
          var pv = document.getElementById("busuanzi_value_site_pv");
          var uv = document.getElementById("busuanzi_value_site_uv");
          if (pv && d.count != null) pv.textContent = d.count;
          if (uv && d.count_unique != null) uv.textContent = d.count_unique;
        })
        .catch(function () {});
    }
    if (document.readyState === "complete") fill();
    else window.addEventListener("load", fill);
    document.addEventListener("swup:page:view", fill);
  })();
</script>
