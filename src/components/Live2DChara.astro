---
// 两位可自由拖动的看板娘（共用一个 WebGL 画布，避免多上下文互相干扰）
//   洛天依  ← SheepLiu712/Agent-LuoTianyi（client/res/live2d/models/luo，非商业免费，模型作者：火爆鸡王）
//   桃濑日和 ← KennardWang/VTuber-MomoseHiyori（MIT）
// 交互：按住拖动；单击播放动作；位置相对右下角记录，窗口缩放后仍贴边
---

<div class="l2d-layer" id="l2dLayer" aria-hidden="true"></div>

<div class="l2d-handle" data-id="tianyi" data-src="/live2d/tianyi/model.model3.json">
  <span class="l2d-name">洛天依</span>
</div>

<div class="l2d-handle" data-id="hiyori" data-src="/live2d/hiyori/hiyori_pro_t08.model3.json">
  <span class="l2d-name">桃濑日和</span>
</div>

<script>
  const LS_POS = 'l2dPos2'; // v2：存相对右下角的偏移 {dx, dy}
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  interface Entry {
    el: HTMLElement;
    id: string;
    src: string;
    model: any;
  }

  const entries: Entry[] = [...document.querySelectorAll<HTMLElement>('.l2d-handle')].map((el) => ({
    el,
    id: el.dataset.id || '',
    src: el.dataset.src || '',
    model: null,
  }));

  const layer = document.getElementById('l2dLayer')!;

  // ---------- 运行时 ----------
  let runtimeReady: Promise<void> | null = null;

  function loadScript(src: string) {
    return new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('加载失败: ' + src));
      document.head.appendChild(s);
    });
  }

  function ensureRuntime() {
    if (!runtimeReady) {
      runtimeReady = (async () => {
        if (!(window as any).PIXI) await loadScript('/lib/pixi/pixi.min.js');
        if (!(window as any).Live2D) await loadScript('/lib/live2d/live2d.min.js'); // Cubism 2 核心
        if (!(window as any).Live2DCubismCore) await loadScript('/lib/live2d/live2dcubismcore.min.js'); // Cubism 4 核心
        const PIXI = (window as any).PIXI;
        if (!PIXI.live2d) await loadScript('/lib/live2d/index.min.js'); // 合并版，同时注册 v2/v4
        try {
          const ready = PIXI?.live2d?.cubism4Ready;
          if (ready && typeof ready.then === 'function') await ready;
        } catch {}
      })();
    }
    return runtimeReady;
  }

  // ---------- 位置（相对右下角的偏移） ----------
  interface Pos { dx: number; dy: number }

  const stored: Record<string, Pos> = (() => {
    try { return JSON.parse(localStorage.getItem(LS_POS) || '{}'); } catch { return {}; }
  })();

  function sizeOf(el: HTMLElement) {
    return { w: el.offsetWidth || 150, h: el.offsetHeight || 210 };
  }

  // 保留至少 60px 在视口内
  function place(el: HTMLElement, left: number, top: number) {
    const { w, h } = sizeOf(el);
    const x = Math.max(Math.min(left, window.innerWidth - 60), -w + 60);
    const y = Math.max(Math.min(top, window.innerHeight - 60), 0);
    el.style.left = x + 'px';
    el.style.top = y + 'px';
  }

  function applyStored(el: HTMLElement, p: Pos) {
    const { w, h } = sizeOf(el);
    place(el, window.innerWidth - w - p.dx, window.innerHeight - h - p.dy);
  }

  function currentPos(el: HTMLElement): Pos {
    const r = el.getBoundingClientRect();
    return { dx: window.innerWidth - (r.left + r.width), dy: window.innerHeight - (r.top + r.height) };
  }

  function savePos(id: string, el: HTMLElement) {
    stored[id] = currentPos(el);
    try { localStorage.setItem(LS_POS, JSON.stringify(stored)); } catch {}
  }

  function defaultPos(el: HTMLElement, index: number): Pos {
    const { w } = sizeOf(el);
    // 洛天依贴右下角，桃濑日和在它左侧
    if (index === 0) return { dx: 20, dy: 20 };
    return { dx: 20 + w + 12, dy: 20 };
  }

  function validPos(p: Pos | undefined, el: HTMLElement) {
    if (!p) return false;
    const { w } = sizeOf(el);
    return (
      Number.isFinite(p.dx) && Number.isFinite(p.dy) &&
      p.dx > -w * 0.5 && p.dx < window.innerWidth &&
      p.dy > -sizeOf(el).h * 0.5 && p.dy < window.innerHeight
    );
  }

  // ---------- 画面 ----------
  let app: any = null;

  function layoutModel(e: Entry) {
    if (!app || !e.model) return;
    const r = e.el.getBoundingClientRect();
    const m = e.model;
    const scale = (r.height / m.internalModel.originalHeight) * 1.02;
    m.scale.set(scale);
    m.x = r.left + (r.width - m.width) / 2;
    m.y = r.top + r.height - m.height + 3;
  }

  async function boot() {
    await ensureRuntime();
    const PIXI = (window as any).PIXI;

    app = new PIXI.Application({
      width: window.innerWidth,
      height: window.innerHeight,
      transparent: true,
      // 抗锯齿/高分辨率在部分环境会让 Cubism 着色器失效
      antialias: false,
      resolution: 1,
      autoStart: !reduced,
    });
    const canvas = app.view as HTMLCanvasElement;
    canvas.className = 'l2d-canvas';
    layer.appendChild(canvas);

    // 串行加载，避免并发初始化互相干扰
    for (const e of entries) {
      try {
        const m = await PIXI.live2d.Live2DModel.from(e.src);
        e.model = m;
        app.stage.addChild(m);
        layoutModel(e);
      } catch (err) {
        console.warn('[live2d]', e.id, err);
      }
    }
    app.render();
  }

  function bootOnce() {
    boot().catch((e) => console.warn('[live2d]', e));
  }

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(bootOnce, { timeout: 2500 });
  } else {
    setTimeout(bootOnce, 1200);
  }

  // ---------- 初始落位 ----------
  let placed = false;
  function positionAll() {
    entries.forEach((e, index) => {
      const s = stored[e.id];
      if (validPos(s, e.el)) applyStored(e.el, s!);
      else {
        const d = defaultPos(e.el, index);
        applyStored(e.el, d);
        savePos(e.id, e.el);
      }
      layoutModel(e);
    });
    placed = true;
  }
  positionAll();
  requestAnimationFrame(positionAll);
  setTimeout(positionAll, 400);

  // ---------- 拖动 ----------
  entries.forEach((e) => {
    let pid: number | null = null;
    let sx = 0, sy = 0, ox = 0, oy = 0, moved = false;

    e.el.addEventListener('pointerdown', (ev) => {
      if (ev.button !== 0) return;
      pid = ev.pointerId;
      try { e.el.setPointerCapture(pid); } catch {}
      sx = ev.clientX; sy = ev.clientY;
      const r = e.el.getBoundingClientRect();
      ox = r.left; oy = r.top;
      moved = false;
      e.el.classList.add('is-dragging');
      ev.preventDefault();
    });

    e.el.addEventListener('pointermove', (ev) => {
      if (pid === null || ev.pointerId !== pid) return;
      const dx = ev.clientX - sx;
      const dy = ev.clientY - sy;
      if (!moved && Math.abs(dx) + Math.abs(dy) > 4) moved = true;
      if (moved) {
        place(e.el, ox + dx, oy + dy);
        layoutModel(e);
      }
    });

    const end = (ev: PointerEvent) => {
      if (pid === null || ev.pointerId !== pid) return;
      try { e.el.releasePointerCapture(pid); } catch {}
      pid = null;
      e.el.classList.remove('is-dragging');
      if (moved) savePos(e.id, e.el);
      else poke(e);
    };
    e.el.addEventListener('pointerup', end);
    e.el.addEventListener('pointercancel', end);
    e.el.addEventListener('touchmove', (ev) => { if (pid !== null) ev.preventDefault(); }, { passive: false });
  });

  function poke(e: Entry) {
    if (!e.model || e.id !== 'tianyi') return;
    try {
      const taps = ['Tap8', 'Tap头', 'Tap袖', 'Tap耳机', 'Tap辫子', 'Tap左腿'];
      e.model.motion(taps[Math.floor(Math.random() * taps.length)]);
    } catch {}
  }

  // ---------- 鼠标跟随 ----------
  if (!reduced) {
    let last = 0;
    window.addEventListener('pointermove', (ev) => {
      const now = performance.now();
      if (now - last < 50) return;
      last = now;
      for (const e of entries) {
        if (!e.model) continue;
        try { e.model.focus(ev.clientX, ev.clientY); } catch {}
      }
    }, { passive: true });
  }

  // ---------- 自适应 ----------
  document.addEventListener('visibilitychange', () => {
    if (!app) return;
    try { document.hidden ? app.stop() : app.start(); } catch {}
  });

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      if (!app || !placed) return; // 落位前忽略 resize，避免把静态位置误存为坐标
      app.renderer.resize(window.innerWidth, window.innerHeight);
      entries.forEach((e) => {
        const p = stored[e.id] || currentPos(e.el);
        applyStored(e.el, p);
        layoutModel(e);
        savePos(e.id, e.el);
      });
      app.render();
    }, 300);
  });
</script>

<style>
  .l2d-layer {
    position: fixed;
    inset: 0;
    z-index: 15;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .l2d-layer :global(canvas.l2d-canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .l2d-handle {
    position: fixed;
    width: clamp(120px, 12vw, 180px);
    height: clamp(160px, 16vw, 240px);
    z-index: 16;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition: filter 0.25s ease;
  }

  .l2d-handle:hover {
    filter: drop-shadow(0 0 12px var(--glow));
  }

  .l2d-handle.is-dragging {
    cursor: grabbing;
  }

  /* 开场播放期间让位 */
  html.intro-on .l2d-layer,
  html.intro-on .l2d-handle {
    opacity: 0;
    pointer-events: none;
  }

  .l2d-name {
    position: absolute;
    left: 50%;
    bottom: -4px;
    transform: translate(-50%, 4px);
    font-family: var(--pixel);
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--dim);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    white-space: nowrap;
  }

  .l2d-handle:hover .l2d-name,
  .l2d-handle.is-dragging .l2d-name {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 600px) {
    .l2d-handle {
      width: clamp(96px, 26vw, 130px);
      height: clamp(130px, 35vw, 176px);
    }
  }
</style>
