---
//
// 氛围层（全站背景，单 rAF 循环，性能预算见下）
// - 暗色 = 夜空：像素星野（明灭）+ 萤火上浮 + 底部波动方程涟漪（PDE 实时求解）
// - 浅色 = 雨后清晨：晨尘飘落 + 樱花花瓣
// - Konami 秘籍（↑↑↓↓←→←→BA）：星尘爆发 + 满屏涟漪
// - 颜色全部读 CSS 变量（--dust-1/2/3），主题切换时 MutationObserver 重建
// - 性能：DPR≤1.5，涟漪模拟 30Hz 封顶（160×36 粗网格有限差分），
//   页面隐藏 / intro 播放 / reduced-motion 时全停
//
---

<canvas class="ambient" id="ambientCanvas" aria-hidden="true"></canvas>

<script>
  interface Mote {
    x: number; y: number; r: number;
    vx: number; vy: number;
    ci: number; a: number; phase: number; tw: number;
  }
  interface Star {
    x: number; y: number; r: number; a: number; phase: number; tw: number;
  }
  interface Petal {
    x: number; y: number; s: number; rot: number; vr: number;
    vy: number; phase: number; a: number;
  }
  interface BurstP {
    x: number; y: number; vx: number; vy: number; life: number; ci: number;
  }

  const canvas = document.getElementById('ambientCanvas') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, dpr = 1;
    let motes: Mote[] = [];
    let stars: Star[] = [];
    let petals: Petal[] = [];
    let bursts: BurstP[] = [];
    let sprites: HTMLCanvasElement[] = [];
    let dark = true;
    let last = 0;
    let simAcc = 0; // 涟漪模拟的 30Hz 累加器

    // ====== 波动方程涟漪（阻尼波 u_tt = c²∇²u，底部一条水面） ======
    const GW = 160, GH = 36;
    let wave0 = new Float32Array(GW * GH);
    let wave1 = new Float32Array(GW * GH);
    const waveCv = document.createElement('canvas');
    waveCv.width = GW; waveCv.height = GH;
    const waveCtx = waveCv.getContext('2d')!;
    const waveImg = waveCtx.createImageData(GW, GH);

    function drop(cx?: number) {
      const x = cx ?? (8 + Math.random() * (GW - 16));
      const y = 4 + Math.random() * (GH - 10);
      const i = (y | 0) * GW + (x | 0);
      wave1[i] = 1;
      wave1[i + 1] = wave1[i - 1] = wave1[i + GW] = wave1[i - GW] = 0.7;
    }

    function waveStep() {
      const C2 = 0.22, DAMP = 0.984;
      for (let y = 1; y < GH - 1; y++) {
        const row = y * GW;
        for (let x = 1; x < GW - 1; x++) {
          const i = row + x;
          const lap = wave1[i - 1] + wave1[i + 1] + wave1[i - GW] + wave1[i + GW] - 4 * wave1[i];
          wave0[i] = (2 * wave1[i] - wave0[i] + C2 * lap) * DAMP;
        }
      }
      const t = wave0; wave0 = wave1; wave1 = t;
    }

    function waveRender() {
      const d = waveImg.data;
      for (let i = 0; i < GW * GH; i++) {
        const v = wave1[i];
        const a = v > 0.02 ? Math.min(v, 1) * 110 : 0;
        d[i * 4] = 150; d[i * 4 + 1] = 190; d[i * 4 + 2] = 255;
        d[i * 4 + 3] = a;
      }
      waveCtx.putImageData(waveImg, 0, 0);
      const stripH = h * 0.22;
      ctx.drawImage(waveCv, 0, h - stripH, w, stripH);
    }

    // ====== 主题与精灵 ======
    function hexToRgb(hex: string): [number, number, number] {
      const m = hex.trim().match(/^#([0-9a-f]{6})$/i);
      if (!m) return [200, 200, 230];
      const v = parseInt(m[1], 16);
      return [(v >> 16) & 255, (v >> 8) & 255, v & 255];
    }

    function makeSprite(rgb: [number, number, number]) {
      const s = document.createElement('canvas');
      s.width = s.height = 24;
      const c = s.getContext('2d')!;
      const g = c.createRadialGradient(12, 12, 0, 12, 12, 12);
      g.addColorStop(0, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},.85)`);
      g.addColorStop(0.4, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},.3)`);
      g.addColorStop(1, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},0)`);
      c.fillStyle = g;
      c.fillRect(0, 0, 24, 24);
      return s;
    }

    function readTheme() {
      dark = document.documentElement.getAttribute('data-theme') !== 'light';
      const cs = getComputedStyle(document.documentElement);
      sprites = ['--dust-1', '--dust-2', '--dust-3']
        .map((v) => makeSprite(hexToRgb(cs.getPropertyValue(v))));
    }

    function spawn() {
      const mobile = w < 640;
      const n = mobile ? 26 : Math.min(64, Math.floor((w * h) / 26000));
      motes = [];
      for (let i = 0; i < n; i++) {
        motes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: 1.4 + Math.random() * 2.4,
          // 夜里缓缓上浮，清晨缓缓飘落
          vx: (Math.random() - 0.5) * 0.12,
          vy: (dark ? -1 : 1) * (0.04 + Math.random() * 0.12),
          ci: Math.floor(Math.random() * 3),
          a: (dark ? 0.06 : 0.1) + Math.random() * (dark ? 0.14 : 0.16),
          phase: Math.random() * Math.PI * 2,
          tw: 0.4 + Math.random() * 1.1,
        });
      }
      // 像素星野（仅暗色）：小方块星星，和像素字体同源的语言
      stars = [];
      if (dark) {
        const sn = mobile ? 70 : Math.min(150, Math.floor((w * h) / 14000));
        for (let i = 0; i < sn; i++) {
          stars.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: Math.random() < 0.85 ? 1 : 2,
            a: 0.12 + Math.random() * 0.3,
            phase: Math.random() * Math.PI * 2,
            tw: 0.3 + Math.random() * 0.9,
          });
        }
      }
      // 樱花花瓣（仅浅色）
      petals = [];
      if (!dark) {
        const pn = mobile ? 5 : 9;
        for (let i = 0; i < pn; i++) {
          petals.push({
            x: Math.random() * w,
            y: Math.random() * h,
            s: 3 + Math.random() * 3,
            rot: Math.random() * Math.PI * 2,
            vr: (Math.random() - 0.5) * 0.02,
            vy: 0.25 + Math.random() * 0.35,
            phase: Math.random() * Math.PI * 2,
            a: 0.35 + Math.random() * 0.3,
          });
        }
      }
    }

    // ====== Konami 星尘爆发 ======
    function konamiBurst() {
      for (let i = 0; i < 240; i++) {
        const ang = Math.random() * Math.PI * 2;
        const sp = 1.5 + Math.random() * 6;
        bursts.push({
          x: w / 2, y: h * 0.4,
          vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - 0.8,
          life: 1, ci: Math.floor(Math.random() * 3),
        });
      }
      for (let i = 0; i < 8; i++) drop();
    }

    // ====== 尺寸与生命周期 ======
    function resize() {
      if (canvas.clientWidth === 0) return; // intro 播放中（display:none），等 class 观察者再试
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      spawn();
    }

    let dropTimer = 0;
    function tick(now: number) {
      requestAnimationFrame(tick);
      if (document.hidden || getComputedStyle(canvas).display === 'none') { last = now; return; }
      const dt = Math.min((now - last) / 16.67, 3) || 1;
      last = now;
      const t = now / 1000;
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';

      // 像素星野
      if (dark) {
        for (const st of stars) {
          ctx.globalAlpha = st.a * (0.7 + 0.3 * Math.sin(t * st.tw + st.phase));
          ctx.fillStyle = '#e6ebff';
          ctx.fillRect(st.x, st.y, st.r, st.r);
        }
      }

      // 光尘
      for (const m of motes) {
        m.x += m.vx * dt;
        m.y += m.vy * dt;
        if (m.y < -8) m.y = h + 8;
        if (m.y > h + 8) m.y = -8;
        if (m.x < -8) m.x = w + 8;
        if (m.x > w + 8) m.x = -8;
        const sway = Math.sin(t * 0.3 + m.phase) * 6;
        const alpha = m.a * (0.6 + 0.4 * Math.sin(t * m.tw + m.phase * 3));
        ctx.globalAlpha = Math.max(alpha, 0);
        const s = m.r * 4;
        ctx.drawImage(sprites[m.ci], m.x + sway - s / 2, m.y - s / 2, s, s);
      }

      // 樱花花瓣（浅色）
      if (!dark) {
        ctx.fillStyle = '#f0c2d4';
        for (const p of petals) {
          p.y += p.vy * dt;
          p.rot += p.vr * dt;
          p.x += Math.sin(t * 0.8 + p.phase) * 0.3 * dt;
          if (p.y > h + 10) { p.y = -10; p.x = Math.random() * w; }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.globalAlpha = p.a;
          ctx.beginPath();
          ctx.ellipse(0, 0, p.s, p.s * 0.45, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      // 波动方程涟漪（暗色，30Hz 封顶）
      if (dark) {
        simAcc += dt;
        if (simAcc >= 2) {
          simAcc = 0;
          dropTimer -= 1;
          if (dropTimer <= 0) { drop(); dropTimer = 18 + Math.random() * 30; }
          waveStep();
        }
        ctx.globalAlpha = 0.8;
        ctx.imageSmoothingEnabled = true;
        waveRender();
      }

      // Konami 爆发粒子
      for (let i = bursts.length - 1; i >= 0; i--) {
        const b = bursts[i];
        b.x += b.vx * dt; b.y += b.vy * dt;
        b.vy += 0.06 * dt;
        b.life -= 0.012 * dt;
        if (b.life <= 0) { bursts.splice(i, 1); continue; }
        ctx.globalAlpha = Math.min(b.life, 0.9);
        const s = 8 + 6 * b.life;
        ctx.drawImage(sprites[b.ci], b.x - s / 2, b.y - s / 2, s, s);
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    readTheme();
    // intro 播放期间 canvas 是 display:none（尺寸 0），等它露出来再初始化尺寸
    let sized = false;
    const ensureSized = () => {
      if (canvas.clientWidth > 0) { sized = true; resize(); }
    };
    new MutationObserver(() => { readTheme(); spawn(); if (sized) return; ensureSized(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    new MutationObserver(() => { if (!sized) ensureSized(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    ensureSized();
    window.addEventListener('resize', resize);
    document.addEventListener('konami', konamiBurst);
    requestAnimationFrame((t) => { last = t; tick(t); });
  }
</script>
