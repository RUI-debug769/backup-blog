---
//
// 氛围层（全站背景，单 rAF 循环，性能预算见下）
// - 暗色 = 雨夜意识体：像素星野（明灭）+ 萤火上浮
//   + Gray-Scott 反应扩散斑图（∂u/∂t = Dᵤ∇²u − uv² + F(1−u)，图灵形态发生，
//     从噪声涌现结构——意识母题的数学化身，全屏低透明度缓慢生长）
// - 浅色 = 雨后清晨：晨尘飘落 + 樱花花瓣
// - Konami 秘籍（↑↑↓↓←→←→BA）：星尘爆发 + 斑图播种
// - 颜色全部读 CSS 变量（--dust-1/2/3），主题切换时 MutationObserver 重建
// - 性能：DPR≤1.5，反应扩散 128×128 粗网格、30Hz 封顶、离屏渲染放大；
//   页面隐藏 / intro 播放 / reduced-motion 时全停
//
---

<canvas class="ambient" id="ambientCanvas" aria-hidden="true"></canvas>

<script>
  interface Mote {
    x: number; y: number; r: number;
    vx: number; vy: number;
    ci: number; a: number; phase: number; tw: number;
  }
  interface Star {
    x: number; y: number; r: number; a: number; phase: number; tw: number;
  }
  interface Petal {
    x: number; y: number; s: number; rot: number; vr: number;
    vy: number; phase: number; a: number;
  }
  interface BurstP {
    x: number; y: number; vx: number; vy: number; life: number; ci: number;
  }

  const canvas = document.getElementById('ambientCanvas') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, dpr = 1;
    let motes: Mote[] = [];
    let stars: Star[] = [];
    let petals: Petal[] = [];
    let bursts: BurstP[] = [];
    let sprites: HTMLCanvasElement[] = [];
    let dark = true;
    let last = 0;
    let simAcc = 0; // 反应扩散 30Hz 封顶
    let seedTimer = 0;

    // ====== Gray-Scott 反应扩散（图灵斑图） ======
    // ∂u/∂t = Dᵤ∇²u − uv² + F(1−u) ; ∂v/∂t = Dᵥ∇²v + uv² − (F+k)v
    const GW = 128, GH = 128;
    const DU = 0.16, DV = 0.08, FEED = 0.0545, KILL = 0.062; // 迷宫纹 regime
    let U = new Float32Array(GW * GH).fill(1);
    let V = new Float32Array(GW * GH);
    const U2 = new Float32Array(GW * GH);
    const V2 = new Float32Array(GW * GH);
    const rdCv = document.createElement('canvas');
    rdCv.width = GW; rdCv.height = GH;
    const rdCtx = rdCv.getContext('2d')!;
    const rdImg = rdCtx.createImageData(GW, GH);
    let rdColor: [number, number, number] = [139, 155, 255];

    function rdSeed(cx?: number, cy?: number) {
      const x0 = cx ?? (10 + Math.random() * (GW - 20));
      const y0 = cy ?? (10 + Math.random() * (GH - 20));
      const r = 2 + Math.random() * 3;
      for (let y = Math.max(0, y0 - r | 0); y < Math.min(GH, y0 + r); y++) {
        for (let x = Math.max(0, x0 - r | 0); x < Math.min(GW, x0 + r); x++) {
          const dx = x - x0, dy = y - y0;
          if (dx * dx + dy * dy < r * r) {
            const i = y * GW + x;
            V[i] = 0.5 + Math.random() * 0.5;
            U[i] = 0.5;
          }
        }
      }
    }

    function rdInit() {
      U.fill(1); V.fill(0);
      for (let i = 0; i < 12; i++) rdSeed();
    }

    function rdStep() {
      for (let y = 0; y < GH; y++) {
        const yu = ((y + GH - 1) % GH) * GW, yd = ((y + 1) % GH) * GW, row = y * GW;
        for (let x = 0; x < GW; x++) {
          const i = row + x;
          const xl = row + ((x + GW - 1) % GW), xr = row + ((x + 1) % GW);
          const lapU = U[xl] + U[xr] + U[yu + x] + U[yd + x] - 4 * U[i];
          const lapV = V[xl] + V[xr] + V[yu + x] + V[yd + x] - 4 * V[i];
          const uvv = U[i] * V[i] * V[i];
          U2[i] = U[i] + DU * lapU - uvv + FEED * (1 - U[i]);
          V2[i] = V[i] + DV * lapV + uvv - (FEED + KILL) * V[i];
        }
      }
      U.set(U2); V.set(V2);
    }

    function rdRender() {
      const d = rdImg.data;
      const [r, g, b] = rdColor;
      for (let i = 0; i < GW * GH; i++) {
        const a = Math.min(V[i] * 1.5, 1) * 52; // 淡而可见：背景里"活着"的纹理
        d[i * 4] = r; d[i * 4 + 1] = g; d[i * 4 + 2] = b;
        d[i * 4 + 3] = a;
      }
      rdCtx.putImageData(rdImg, 0, 0);
      ctx.drawImage(rdCv, 0, 0, w, h);
    }

    // ====== 主题与精灵 ======
    function hexToRgb(hex: string): [number, number, number] {
      const m = hex.trim().match(/^#([0-9a-f]{6})$/i);
      if (!m) return [200, 200, 230];
      const v = parseInt(m[1], 16);
      return [(v >> 16) & 255, (v >> 8) & 255, v & 255];
    }

    function makeSprite(rgb: [number, number, number]) {
      const s = document.createElement('canvas');
      s.width = s.height = 24;
      const c = s.getContext('2d')!;
      const g = c.createRadialGradient(12, 12, 0, 12, 12, 12);
      g.addColorStop(0, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},.85)`);
      g.addColorStop(0.4, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},.3)`);
      g.addColorStop(1, `rgba(${rgb[0]},${rgb[1]},${rgb[2]},0)`);
      c.fillStyle = g;
      c.fillRect(0, 0, 24, 24);
      return s;
    }

    function readTheme() {
      dark = document.documentElement.getAttribute('data-theme') !== 'light';
      const cs = getComputedStyle(document.documentElement);
      const dust = ['--dust-1', '--dust-2', '--dust-3']
        .map((v) => hexToRgb(cs.getPropertyValue(v)));
      sprites = dust.map(makeSprite);
      rdColor = dust[1]; // 斑图用雾蓝/紫罗兰
    }

    function spawn() {
      const mobile = w < 640;
      const n = mobile ? 26 : Math.min(64, Math.floor((w * h) / 26000));
      motes = [];
      for (let i = 0; i < n; i++) {
        motes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: 1.4 + Math.random() * 2.4,
          // 夜里缓缓上浮，清晨缓缓飘落
          vx: (Math.random() - 0.5) * 0.12,
          vy: (dark ? -1 : 1) * (0.04 + Math.random() * 0.12),
          ci: Math.floor(Math.random() * 3),
          a: (dark ? 0.09 : 0.16) + Math.random() * (dark ? 0.17 : 0.22),
          phase: Math.random() * Math.PI * 2,
          tw: 0.4 + Math.random() * 1.1,
        });
      }
      // 像素星野（仅暗色）：小方块星星，和像素字体同源的语言
      stars = [];
      if (dark) {
        const sn = mobile ? 90 : Math.min(200, Math.floor((w * h) / 11000));
        for (let i = 0; i < sn; i++) {
          stars.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: Math.random() < 0.75 ? 1 : 2,
            a: 0.2 + Math.random() * 0.35,
            phase: Math.random() * Math.PI * 2,
            tw: 0.3 + Math.random() * 0.9,
          });
        }
      }
      // 樱花花瓣（仅浅色）
      petals = [];
      if (!dark) {
        const pn = mobile ? 7 : 12;
        for (let i = 0; i < pn; i++) {
          petals.push({
            x: Math.random() * w,
            y: Math.random() * h,
            s: 3.5 + Math.random() * 3.5,
            rot: Math.random() * Math.PI * 2,
            vr: (Math.random() - 0.5) * 0.02,
            vy: 0.25 + Math.random() * 0.35,
            phase: Math.random() * Math.PI * 2,
            a: 0.45 + Math.random() * 0.3,
          });
        }
      }
    }

    // ====== Konami 星尘爆发 + 斑图播种（n/seeds 可调，主题切换时用小型版） ======
    function konamiBurst(n = 240, seeds = 8) {
      for (let i = 0; i < n; i++) {
        const ang = Math.random() * Math.PI * 2;
        const sp = 1.5 + Math.random() * 6;
        bursts.push({
          x: w / 2, y: h * 0.4,
          vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - 0.8,
          life: 1, ci: Math.floor(Math.random() * 3),
        });
      }
      if (dark) for (let i = 0; i < seeds; i++) rdSeed(); // 斑图同时开花
    }

    // ====== 尺寸与生命周期 ======
    function resize() {
      if (canvas.clientWidth === 0) return; // intro 播放中（display:none），等 class 观察者再试
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      spawn();
    }

    function tick(now: number) {
      requestAnimationFrame(tick);
      if (document.hidden || getComputedStyle(canvas).display === 'none') { last = now; return; }
      const dt = Math.min((now - last) / 16.67, 3) || 1;
      last = now;
      const t = now / 1000;
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';

      // 反应扩散斑图（暗色底层，30Hz 封顶）
      if (dark) {
        simAcc += dt;
        if (simAcc >= 2) {
          simAcc = 0;
          for (let s = 0; s < 6; s++) rdStep();
          seedTimer -= 1;
          if (seedTimer <= 0) { rdSeed(); seedTimer = 60 + Math.random() * 90; }
          ctx.globalAlpha = 1;
          ctx.imageSmoothingEnabled = true;
          rdRender();
        } else {
          rdRender(); // 非模拟帧也要重画（清屏后）
        }
      }

      // 像素星野
      if (dark) {
        for (const st of stars) {
          ctx.globalAlpha = st.a * (0.7 + 0.3 * Math.sin(t * st.tw + st.phase));
          ctx.fillStyle = '#e6ebff';
          ctx.fillRect(st.x, st.y, st.r, st.r);
        }
      }

      // 光尘
      for (const m of motes) {
        m.x += m.vx * dt;
        m.y += m.vy * dt;
        if (m.y < -8) m.y = h + 8;
        if (m.y > h + 8) m.y = -8;
        if (m.x < -8) m.x = w + 8;
        if (m.x > w + 8) m.x = -8;
        const sway = Math.sin(t * 0.3 + m.phase) * 6;
        const alpha = m.a * (0.6 + 0.4 * Math.sin(t * m.tw + m.phase * 3));
        ctx.globalAlpha = Math.max(alpha, 0);
        const s = m.r * 4;
        ctx.drawImage(sprites[m.ci], m.x + sway - s / 2, m.y - s / 2, s, s);
      }

      // 樱花花瓣（浅色）
      if (!dark) {
        ctx.fillStyle = '#f0c2d4';
        for (const p of petals) {
          p.y += p.vy * dt;
          p.rot += p.vr * dt;
          p.x += Math.sin(t * 0.8 + p.phase) * 0.3 * dt;
          if (p.y > h + 10) { p.y = -10; p.x = Math.random() * w; }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.globalAlpha = p.a;
          ctx.beginPath();
          ctx.ellipse(0, 0, p.s, p.s * 0.45, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      // Konami 爆发粒子
      for (let i = bursts.length - 1; i >= 0; i--) {
        const b = bursts[i];
        b.x += b.vx * dt; b.y += b.vy * dt;
        b.vy += 0.06 * dt;
        b.life -= 0.012 * dt;
        if (b.life <= 0) { bursts.splice(i, 1); continue; }
        ctx.globalAlpha = Math.min(b.life, 0.9);
        const s = 8 + 6 * b.life;
        ctx.drawImage(sprites[b.ci], b.x - s / 2, b.y - s / 2, s, s);
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    readTheme();
    rdInit();
    // intro 播放期间 canvas 是 display:none（尺寸 0），等它露出来再初始化尺寸
    let sized = false;
    const ensureSized = () => {
      if (canvas.clientWidth > 0) { sized = true; resize(); }
    };
    // 主题切换瞬间：一小阵星尘涌出，让"天亮/入夜"本身被看见
    let firstTheme = true;
    new MutationObserver(() => {
      readTheme(); spawn();
      if (firstTheme) { firstTheme = false; return; }
      if (sized) konamiBurst(50, 3);
      else ensureSized();
    })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    new MutationObserver(() => { if (!sized) ensureSized(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    ensureSized();
    window.addEventListener('resize', resize);
    document.addEventListener('konami', konamiBurst);
    requestAnimationFrame((t) => { last = t; tick(t); });
  }
</script>
