---
/**
 * 前沿日报/周报聚合页：按发布日期倒序列出全部报告。
 * 数据来自 reports collection（scripts/sync-reports.mjs 从 frontier-report 同步）。
 */
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";

const reports = (await getCollection("reports"))
	.filter((r) => !r.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

type ReportEntry = (typeof reports)[number];

/** 类型徽标：category / tags 含「周报」或文件名含 weekly → 周报，否则日报 */
function reportKind(entry: ReportEntry): "日报" | "周报" {
	if (entry.data.category.includes("周报")) return "周报";
	if (entry.data.tags.some((t) => t.includes("周报"))) return "周报";
	if (entry.id.includes("weekly")) return "周报";
	return "日报";
}

const weeklyCount = reports.filter((r) => reportKind(r) === "周报").length;
---

<MainGridLayout title="前沿日报" description="AI 前沿日报与周报存档" page="reports">
	<section class="reports-intro">
		<h1 class="reports-title">前沿日报</h1>
		<p class="reports-lead">AI 前沿动态：每天一份日报，每周末一份周报。</p>
		<p class="reports-meta">
			{reports.length} 篇 · {reports.length - weeklyCount} 日报 / {weeklyCount} 周报 · 由 frontier-report 同步
		</p>
	</section>

	<section class="reports-list">
		{reports.length === 0 && <p class="reports-empty">暂无内容，等待首次同步。</p>}
		{
			reports.map((r) => {
				const kind = reportKind(r);
				const dateStr = formatDateToYYYYMMDD(r.data.published);
				return (
					<a class="reports-item" href={`/reports/${encodeURIComponent(r.id)}/`}>
						<span class={`reports-badge reports-badge--${kind === "周报" ? "weekly" : "daily"}`}>{kind}</span>
						<span class="reports-item__main">
							<span class="reports-item__title">{r.data.title}</span>
							{r.data.description && <span class="reports-item__desc">{r.data.description}</span>}
						</span>
						<time class="reports-item__date" datetime={dateStr}>{dateStr}</time>
					</a>
				);
			})
		}
	</section>
</MainGridLayout>

<style>
	.reports-intro { margin: 0 0 2.5rem; }
	.reports-title { font: var(--m3e-type-headline-large); margin: 0 0 0.75rem; }
	.reports-lead { font: var(--m3e-type-body-large); color: var(--on-surface-variant); margin: 0 0 0.5rem; }
	.reports-meta { font: var(--m3e-type-label-medium); color: var(--on-surface-variant); opacity: 0.7; margin: 0; }
	.reports-list { display: flex; flex-direction: column; }
	.reports-empty { font: var(--m3e-type-body-medium); color: var(--on-surface-variant); }
	.reports-item { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.75rem 0; border-bottom: 1px dashed color-mix(in oklab, var(--on-surface) 10%, transparent); text-decoration: none; color: inherit; }
	.reports-item:hover .reports-item__title { color: var(--primary); }
	.reports-badge { flex-shrink: 0; padding: 0.15rem 0.6rem; border-radius: var(--shape-corner-full); font: var(--m3e-type-label-medium); }
	.reports-badge--daily { background: var(--secondary-container); color: var(--on-secondary-container); }
	.reports-badge--weekly { background: var(--tertiary-container); color: var(--on-tertiary-container); }
	.reports-item__main { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
	.reports-item__title { font: var(--m3e-type-body-large); transition: color 0.15s; }
	.reports-item__desc { font: var(--m3e-type-body-small); color: var(--on-surface-variant); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.reports-item__date { margin-left: auto; flex-shrink: 0; font: var(--m3e-type-label-medium); color: var(--on-surface-variant); }
</style>
