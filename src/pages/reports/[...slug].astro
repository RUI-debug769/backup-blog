---
/**
 * 前沿日报/周报详情页：直接嵌入云端生成的暖陶面板 HTML（与原邮件版逐像素一致）。
 * HTML 由 scripts/ai_report/run.py 写入 src/data/reports/<id>.html；
 * 没有 HTML 时退回渲染 .md 正文。
 */
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Markdown from "@components/content/Markdown.astro";
import { getCollection, render } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import "../../styles/report-warm.css";

const rawHtml = import.meta.glob("/src/data/reports/*.html", {
	query: "?raw",
	import: "default",
	eager: true,
}) as Record<string, string>;

export async function getStaticPaths() {
	const reports = await getCollection("reports");
	return reports
		.filter((entry) => !entry.data.draft)
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, published, category, tags } = entry.data;

/** 类型徽标：category / tags 含 weekly/周报，或文件名含 weekly → Weekly，否则 Daily */
const isWeekly =
	/weekly|周报/i.test(category) ||
	tags.some((t) => /weekly|周报/i.test(t)) ||
	entry.id.includes("weekly");
const kind = isWeekly ? "Weekly" : "Daily";
const dateStr = formatDateToYYYYMMDD(published);
const innerHtml = rawHtml[`/src/data/reports/${entry.id}.html`];
---

<MainGridLayout title={title} description={`${title} — Frontier ${kind}`} page="reports">
	<article class="report-article report-warm">
		<header class="report-article__head">
			<h1>{title}</h1>
			<div class="report-article__meta">
				<span class={`report-badge report-badge--${isWeekly ? "weekly" : "daily"}`}>{kind}</span>
				<time datetime={dateStr}>{dateStr}</time>
			</div>
		</header>

		{
			innerHtml ? (
				<div class="rw-shell">
					<div class="rw-panel" set:html={innerHtml} />
				</div>
			) : (
				<Markdown class="report-article__body">
					<Content />
				</Markdown>
			)
		}

		<footer class="report-article__foot">
			<a href="/reports/" class="report-back">← All reports</a>
		</footer>
	</article>
</MainGridLayout>

<style>
	.report-article { max-width: 46rem; }
	.report-article__head { margin-bottom: 1.5rem; }
	.report-article__head h1 { font: var(--m3e-type-headline-medium); margin: 0 0 0.75rem; line-height: 1.3; }
	.report-article__meta { display: flex; align-items: center; gap: 0.75rem; font: var(--m3e-type-label-medium); color: var(--on-surface-variant); }
	.report-badge { padding: 0.15rem 0.6rem; border-radius: var(--shape-corner-full); }
	.report-badge--daily { background: var(--secondary-container); color: var(--on-secondary-container); }
	.report-badge--weekly { background: var(--tertiary-container); color: var(--on-tertiary-container); }
	.report-article__body { margin-bottom: 2rem; }
	.report-article__foot { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; margin-top: 2rem; border-top: 1px solid color-mix(in oklab, var(--on-surface) 12%, transparent); font: var(--m3e-type-label-large); }
	.report-article__foot a { color: var(--primary); text-decoration: none; }
	.report-article__foot a:hover { text-decoration: underline; }
</style>
