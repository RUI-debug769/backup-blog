---
/**
 * 分类索引页：一级分类 + 二级子类的层级总览（参考 blog.cosine.ren 的目录结构）。
 * category 字段用 "一级/二级" 形式（如 笔记/AI）。一级行计数含全部子类，
 * 点击进入归档页对应分类过滤（/archive/?category=x，过滤为前缀匹配）。
 */
import Card from "@components/atoms/display/Card.svelte";
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategoryList } from "@utils/content-utils";
import { getCategoryUrl } from "@utils/url-utils";
import { displayCategory } from "@utils/category-display";

const categories = await getCategoryList();
const totalPosts = categories.reduce(
	(sum, category) => sum + category.count,
	0,
);
const categorySummary = `${categories.length} ${i18n(I18nKey.categoriesCount)} · ${totalPosts} ${i18n(I18nKey.postsCount)}`;

type SubRow = { name: string; count: number; url: string };
type Group = { name: string; count: number; url: string; subs: SubRow[] };
const tree = new Map<string, Group>();
for (const c of categories) {
	const [topRaw, ...rest] = c.name.split("/");
	const top = topRaw.trim();
	const sub = rest.join("/").trim();
	if (!tree.has(top)) {
		tree.set(top, { name: top, count: 0, url: getCategoryUrl(top), subs: [] });
	}
	const node = tree.get(top)!;
	node.count += c.count;
	if (sub) node.subs.push({ name: sub, count: c.count, url: c.url });
	else node.url = c.url;
}
const groups = [...tree.values()].sort((a, b) => a.name.localeCompare(b.name, "zh"));
---

<MainGridLayout title={i18n(I18nKey.categories)} description={categorySummary} page="categories">
	<Card color="var(--card-bg)" radius="l" class="category-index px-8 py-6">
		<PageHeader
			icon="material-symbols:folder-outline-rounded"
			title={i18n(I18nKey.categories)}
				subtitle={categorySummary}
		/>
		{groups.length > 0 && (
			<ul class="category-index__list">
				{groups.map((group) => (
					<>
						<li class="category-index__top">
							<a class="category-index__row m3-state-layer" href={group.url}>
								<MetaIcon icon="material-symbols:folder-outline-rounded" />
								<span class="category-index__name">{group.name}</span>
								<span class="category-index__rule" aria-hidden="true"></span>
								<span class="category-index__count">{group.count}</span>
							</a>
						</li>
						{group.subs.map((sub) => (
							<li>
								<a class="category-index__row category-index__row--sub m3-state-layer" href={sub.url}>
									<MetaIcon icon="material-symbols:subdirectory-arrow-right-rounded" />
									<span class="category-index__name">{group.name} / {sub.name}</span>
									<span class="category-index__rule" aria-hidden="true"></span>
									<span class="category-index__count">{sub.count}</span>
								</a>
							</li>
						))}
					</>
				))}
			</ul>
		)}
		{groups.length === 0 && (
			<div class="category-index__empty">
				<span>{i18n(I18nKey.noData)}</span>
			</div>
		)}
	</Card>
</MainGridLayout>

<style lang="stylus">
@import "../styles/breakpoints.styl"

.category-index
	display: block

	&__list
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-2) var(--m3e-space-4)
		margin: 0
		padding: 0
		list-style: none

	&__top
		grid-column: 1 / -1

	&__row
		display: flex
		align-items: center
		gap: var(--m3e-space-3)
		min-height: 3.5rem
		padding: var(--m3e-space-3) var(--m3e-space-4)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		text-decoration: none
		--m3e-state-color: var(--on-surface)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			background: unquote("color-mix(in oklab, var(--on-surface) 6%, transparent)")

	&__row--sub
		min-height: 2.75rem
		.category-index__name
			font-size: 0.9em
			opacity: 0.85

	&__name
		flex-shrink: 0

	&__rule
		flex: 1
		border-bottom: 1px dashed var(--outline-variant)

	&__count
		color: var(--on-surface-variant)
		font-size: 0.9em
</style>
