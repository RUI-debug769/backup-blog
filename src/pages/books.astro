---
/**
 * 书单页：本地 books.ts 数据，静态渲染 + 极简状态筛选。
 * 视觉对齐追番页（2:3 封面、状态 pill、评分、一句话感想）。
 */
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { booksData, BOOK_STATUS_META } from "../data/books.ts";

const pageTitle = "Books";
const pageDescription = "书架——在读、读过与想读";

const books = booksData;
const statusOrder = ["reading", "completed", "planned", "onHold"] as const;
const counts = Object.fromEntries(
	statusOrder.map((s) => [s, books.filter((b) => b.status === s).length]),
);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="books">
	<section class="books-section" aria-label={pageTitle}>
		<header class="books-header">
			<h1 class="books-title">{pageTitle}</h1>
			<p class="books-subtitle">{pageDescription}</p>
		</header>

		<nav class="books-filter" aria-label="Filter by status">
			<button class="books-chip is-active" data-filter="all">
				All <span class="books-chip-count">{books.length}</span>
			</button>
			{
				statusOrder.map((s) => (
					<button class="books-chip" data-filter={s}>
						{BOOK_STATUS_META[s].label}
						<span class="books-chip-count">{counts[s]}</span>
					</button>
				))
			}
		</nav>

		<div class="books-grid" id="books-grid">
			{
				books.map((book) => {
					const meta = BOOK_STATUS_META[book.status];
					return (
						<article class="book-card" data-status={book.status}>
							{book.link ? (
								<a
									class="book-card__cover"
									href={book.link}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={book.title}
								>
									{book.cover ? (
										<img
											src={book.cover}
											alt={book.title}
											width="240"
											height="360"
											loading="lazy"
											decoding="async"
										/>
									) : (
										<span class="book-card__placeholder" aria-hidden="true">
											{book.title.slice(0, 1)}
										</span>
									)}
								</a>
							) : (
								<div class="book-card__cover" aria-hidden="true">
									{book.cover ? (
										<img
											src={book.cover}
											alt=""
											width="240"
											height="360"
											loading="lazy"
											decoding="async"
										/>
									) : (
										<span class="book-card__placeholder">
											{book.title.slice(0, 1)}
										</span>
									)}
								</div>
							)}
							<div class="book-card__body">
								<span class={`book-card__status book-card__status--${book.status}`}>
									{meta.label}
								</span>
								<h2 class="book-card__title">{book.title}</h2>
								{book.author && <p class="book-card__author">{book.author}</p>}
								{book.rating > 0 && (
									<p class="book-card__rating" aria-label={`Rating ${book.rating} / 10`}>
										{"★".repeat(Math.round(book.rating / 2))}
										<span class="book-card__rating-num">{book.rating.toFixed(1)}</span>
									</p>
								)}
								{book.description && (
									<p class="book-card__desc">{book.description}</p>
								)}
								<p class="book-card__meta">
									{[book.year, ...book.genres].filter(Boolean).join(" · ")}
								</p>
							</div>
						</article>
					);
				})
			}
		</div>
		<p class="books-empty" id="books-empty" hidden>No books matched your filter.</p>
	</section>
</MainGridLayout>

<style>
	.books-section {
		padding-bottom: 2rem;
	}
	.books-header {
		margin-bottom: 1.25rem;
	}
	.books-title {
		font: var(--m3e-type-headline-large, 700 2rem/1.3 sans-serif);
		color: var(--on-surface);
		margin: 0;
	}
	.books-subtitle {
		font: var(--m3e-type-body-medium, 400 0.875rem/1.6 sans-serif);
		color: var(--on-surface-variant);
		margin: 0.25rem 0 0;
	}

	.books-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.books-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.875rem;
		border-radius: var(--shape-corner-full, 999px);
		border: 1px solid var(--outline-variant, rgba(128, 128, 128, 0.3));
		background: transparent;
		color: var(--on-surface-variant);
		font: var(--m3e-type-label-large, 500 0.875rem/1.4 sans-serif);
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.books-chip:hover {
		border-color: var(--primary);
		color: var(--primary);
	}
	.books-chip.is-active {
		background: var(--secondary-container, var(--primary-container));
		color: var(--on-secondary-container, var(--on-primary-container));
		border-color: transparent;
	}
	.books-chip-count {
		opacity: 0.7;
		font-size: 0.8em;
	}

	.books-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1.25rem;
	}
	@media (max-width: 480px) {
		.books-grid {
			grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
			gap: 1rem;
		}
	}

	.book-card {
		display: flex;
		flex-direction: column;
		border-radius: var(--shape-corner-l, 1rem);
		background: var(--card-bg, var(--surface-container-low));
		overflow: hidden;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.book-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--m3e-elevation-2, 0 4px 16px rgba(0, 0, 0, 0.12));
	}
	.book-card[hidden] {
		display: none;
	}

	.book-card__cover {
		position: relative;
		display: block;
		aspect-ratio: 2 / 3;
		background: linear-gradient(
			135deg,
			var(--surface-container) 0%,
			var(--surface-container-highest) 100%
		);
		overflow: hidden;
	}
	.book-card__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.book-card__placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 3rem;
		font-weight: 700;
		color: var(--primary);
		opacity: 0.35;
		user-select: none;
	}

	.book-card__body {
		padding: 0.875rem 1rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		flex: 1;
	}
	.book-card__status {
		align-self: flex-start;
		font: var(--m3e-type-label-small, 500 0.7rem/1.4 sans-serif);
		padding: 0.125rem 0.5rem;
		border-radius: var(--shape-corner-full, 999px);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.book-card__status--reading {
		background: var(--primary-container);
		color: var(--on-primary-container);
	}
	.book-card__status--completed {
		background: var(--tertiary-container, var(--secondary-container));
		color: var(--on-tertiary-container, var(--on-secondary-container));
	}
	.book-card__status--planned {
		background: var(--secondary-container);
		color: var(--on-secondary-container);
	}
	.book-card__status--onHold {
		background: var(--surface-container-highest);
		color: var(--on-surface-variant);
	}

	.book-card__title {
		font: var(--m3e-type-title-small, 600 0.95rem/1.35 sans-serif);
		color: var(--on-surface);
		margin: 0.25rem 0 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.book-card__author {
		font: var(--m3e-type-body-small, 400 0.8rem/1.4 sans-serif);
		color: var(--on-surface-variant);
		margin: 0;
	}
	.book-card__rating {
		margin: 0.125rem 0 0;
		color: var(--primary);
		font-size: 0.85rem;
	}
	.book-card__rating-num {
		margin-left: 0.375rem;
		color: var(--on-surface-variant);
		font-size: 0.75rem;
	}
	.book-card__desc {
		font: var(--m3e-type-body-small, 400 0.8rem/1.5 sans-serif);
		color: var(--on-surface-variant);
		margin: 0.25rem 0 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.book-card__meta {
		margin: auto 0 0;
		padding-top: 0.5rem;
		font: var(--m3e-type-label-small, 500 0.72rem/1.4 sans-serif);
		color: var(--on-surface-variant);
		opacity: 0.75;
	}
	.books-empty {
		text-align: center;
		color: var(--on-surface-variant);
		padding: 3rem 0;
	}
</style>

<script is:inline>
	(() => {
		const grid = document.getElementById("books-grid");
		const empty = document.getElementById("books-empty");
		const chips = document.querySelectorAll(".books-chip");
		if (!grid || !chips.length) return;
		chips.forEach((chip) => {
			chip.addEventListener("click", () => {
				chips.forEach((c) => c.classList.remove("is-active"));
				chip.classList.add("is-active");
				const f = chip.getAttribute("data-filter");
				let visible = 0;
				grid.querySelectorAll(".book-card").forEach((card) => {
					const show = f === "all" || card.getAttribute("data-status") === f;
					card.hidden = !show;
					if (show) visible++;
				});
				if (empty) empty.hidden = visible !== 0;
			});
		});
	})();
</script>
