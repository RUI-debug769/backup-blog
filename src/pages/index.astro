---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const CATEGORY_LABEL: Record<string, string> = {
  portfolio: '作品集',
  demo: '随便做的 demo',
  essay: '随笔',
};
/* 每组的看板角色：作品集=炼金术士（把思想铸成工具） demo=小魔女 随笔=窗边读书 */
const GROUP_CHARA: Record<string, string> = {
  portfolio: '/assets/chara/chara-alchemist.webp',
  demo: '/assets/chara/chara-witch.webp',
  essay: '/assets/chara/chara-reader.webp',
};
const groups = ['portfolio', 'demo', 'essay']
  .map((c) => ({ key: c, label: CATEGORY_LABEL[c], items: posts.filter((p) => p.data.category === c) }))
  .filter((g) => g.items.length > 0);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout>
  {
    groups.map((group) => (
      <section class:list={['post-group', { 'post-group--cards': group.key === 'portfolio' }]}>
        <div class="group-head">
          <img class="group-chara sketch" src={GROUP_CHARA[group.key]} alt="" loading="lazy" draggable="false" />
          <h2 class="group-title">{group.label}</h2>
        </div>
        <ul class="post-list">
          {group.items.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`}>
                <h3 class="post-title">{post.data.title}</h3>
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {/* 数学角：正二十面体 —— A₅ 的忠实表示 */}
  <section class="math-corner">
    <canvas id="icoCanvas" width="150" height="150" aria-hidden="true"></canvas>
    <p class="math-caption">A₅ · 正二十面体的旋转表示（|A₅| = 60）</p>
  </section>
</BaseLayout>

<script>
  // 数学角：正二十面体旋转线框 —— A₅（60 阶交错群）的忠实旋转表示
  // 性能：30fps 封顶 + IntersectionObserver 离屏暂停 + reduced-motion 不启动
  const ico = document.getElementById('icoCanvas') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (ico && !reduced) {
    const ctx = ico.getContext('2d')!;
    const S = 150;
    ico.width = S; ico.height = S;
    const PHI = (1 + Math.sqrt(5)) / 2;
    const V: number[][] = [];
    for (const a of [-1, 1]) for (const b of [-1, 1]) {
      V.push([a, b * PHI, 0], [0, a, b * PHI], [a * PHI, 0, b]);
    }
    const norm = Math.sqrt(1 + PHI * PHI);
    V.forEach((v) => { v[0] /= norm; v[1] /= norm; v[2] /= norm; });
    const E: [number, number][] = [];
    for (let i = 0; i < 12; i++) for (let j = i + 1; j < 12; j++) {
      const d = Math.hypot(V[i][0] - V[j][0], V[i][1] - V[j][1], V[i][2] - V[j][2]);
      if (d < 1.1) E.push([i, j]); // 最短边长 = 2/norm ≈ 1.05
    }
    let running = false, last = 0, rot = 0.4;
    function frame(now: number) {
      if (!running) return;
      requestAnimationFrame(frame);
      if (now - last < 33) return; // 30fps 封顶
      last = now;
      rot += 0.006;
      const cy = Math.cos(rot), sy = Math.sin(rot);
      const cx = Math.cos(rot * 0.37), sx = Math.sin(rot * 0.37);
      const P = V.map(([x, y, z]) => {
        const x1 = x * cy + z * sy, z1 = -x * sy + z * cy; // 绕 Y
        const y2 = y * cx - z1 * sx, z2 = y * sx + z1 * cx; // 绕 X 微倾
        return [S / 2 + x1 * 52, S / 2 + y2 * 52, z2];
      });
      ctx.clearRect(0, 0, S, S);
      const cs = getComputedStyle(document.documentElement);
      const accent = cs.getPropertyValue('--accent').trim() || '#8b9bff';
      for (const [i, j] of E) {
        const depth = (P[i][2] + P[j][2]) / 2; // -1..1
        ctx.globalAlpha = 0.18 + 0.4 * (depth + 1) / 2;
        ctx.strokeStyle = accent;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(P[i][0], P[i][1]);
        ctx.lineTo(P[j][0], P[j][1]);
        ctx.stroke();
      }
      ctx.fillStyle = accent;
      for (const p of P) {
        ctx.globalAlpha = 0.35 + 0.5 * (p[2] + 1) / 2;
        ctx.fillRect(p[0] - 1.5, p[1] - 1.5, 3, 3); // 像素顶点，与星野同源
      }
      ctx.globalAlpha = 1;
    }
    new IntersectionObserver((entries) => {
      const vis = entries[0].isIntersecting;
      if (vis && !running) { running = true; last = 0; requestAnimationFrame(frame); }
      if (!vis) running = false;
    }).observe(ico);
  }
</script>

<style>
  .post-group + .post-group {
    margin-top: 2.6rem;
  }

  /* 分组标题：像素体 + 看板角色 + 尾星 */
  .group-head {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 1rem;
  }
  .group-chara {
    height: 52px;
    margin-bottom: -6px;
  }
  .group-title {
    font-family: var(--pixel);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--dim);
    margin-bottom: 0;
  }
  .group-title::after {
    content: "✦";
    margin-left: 0.7em;
    opacity: 0.5;
  }

  /* 作品集：渐变描边卡片，hover 微微浮起 */
  .post-group--cards .post-list {
    gap: 14px;
  }
  .post-group--cards .post-item {
    padding: 20px 22px;
    border: 1px solid transparent;
    border-radius: 16px;
    background:
      linear-gradient(var(--chip), var(--chip)) padding-box,
      linear-gradient(135deg, rgba(139, 155, 255, 0.5), rgba(92, 225, 255, 0.3), rgba(255, 92, 138, 0.3)) border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .post-group--cards .post-item:first-child {
    border-top: 1px solid transparent;
  }
  .post-group--cards .post-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px var(--glow);
  }

  html[data-theme="light"] .post-group--cards .post-item {
    background:
      linear-gradient(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.55)) padding-box,
      linear-gradient(135deg, rgba(102, 114, 232, 0.35), rgba(192, 176, 228, 0.4), rgba(232, 188, 212, 0.35)) border-box;
  }
</style>
