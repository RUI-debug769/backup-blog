---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const CATEGORY_LABEL: Record<string, string> = {
  portfolio: '作品集',
  demo: '随便做的 demo',
  essay: '随笔',
};
/* 每组的看板角色：作品集=炼金术士（把思想铸成工具） demo=小魔女 随笔=窗边读书 */
const GROUP_CHARA: Record<string, string> = {
  portfolio: '/assets/chara/chara-alchemist.webp',
  demo: '/assets/chara/chara-witch.webp',
  essay: '/assets/chara/chara-reader.webp',
};
const groups = ['portfolio', 'demo', 'essay']
  .map((c) => ({ key: c, label: CATEGORY_LABEL[c], items: posts.filter((p) => p.data.category === c) }))
  .filter((g) => g.items.length > 0);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout>
  {
    groups.map((group) => (
      <section class:list={['post-group', { 'post-group--cards': group.key === 'portfolio' }]}>
        <div class="group-head">
          <img class="group-chara sketch" src={GROUP_CHARA[group.key]} alt="" loading="lazy" draggable="false" />
          <h2 class="group-title">{group.label}</h2>
        </div>
        <ul class="post-list">
          {group.items.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`}>
                <h3 class="post-title">{post.data.title}</h3>
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .post-group + .post-group {
    margin-top: 2.6rem;
  }

  /* 分组标题：像素体 + 看板角色 + 尾星 */
  .group-head {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 1rem;
  }
  .group-chara {
    height: 52px;
    margin-bottom: -6px;
  }
  .group-title {
    font-family: var(--pixel);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--dim);
    margin-bottom: 0;
  }
  .group-title::after {
    content: "✦";
    margin-left: 0.7em;
    opacity: 0.5;
  }

  /* 作品集：渐变描边卡片，hover 微微浮起 */
  .post-group--cards .post-list {
    gap: 14px;
  }
  .post-group--cards .post-item {
    padding: 20px 22px;
    border: 1px solid transparent;
    border-radius: 16px;
    background:
      linear-gradient(var(--chip), var(--chip)) padding-box,
      linear-gradient(135deg, rgba(139, 155, 255, 0.5), rgba(92, 225, 255, 0.3), rgba(255, 92, 138, 0.3)) border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .post-group--cards .post-item:first-child {
    border-top: 1px solid transparent;
  }
  .post-group--cards .post-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px var(--glow);
  }

  html[data-theme="light"] .post-group--cards .post-item {
    background:
      linear-gradient(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.55)) padding-box,
      linear-gradient(135deg, rgba(102, 114, 232, 0.35), rgba(192, 176, 228, 0.4), rgba(232, 188, 212, 0.35)) border-box;
  }
</style>
