---
/**
 * /graph/：全站双链关系图（Obsidian 式）。
 * 服务端把 buildWikiGraph() 的结果序列化为 JSON，客户端 canvas 画力导向图：
 * 节点=文章（thinking 紫 / posts 青），边=出链；拖拽/悬停/点击跳转。
 */
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { buildWikiGraph } from "@utils/wiki-links";

const graph = await buildWikiGraph();
const nodes = [...graph.nodes.values()].map((n) => ({
	id: n.id,
	title: n.title,
	url: n.url,
	kind: n.kind,
	school: n.school ?? "",
}));
const edges: Array<[string, string]> = [];
for (const [src, outs] of graph.outlinks) {
	for (const dst of outs) edges.push([src, dst]);
}
const data = { nodes, edges, broken: graph.broken.length };
---

<MainGridLayout title="Wiki Graph" description="双链关系图：文章之间的引用网络" page="graph">
	<section class="graph-head">
		<h1>Wiki Graph</h1>
		<p class="graph-meta">
			{nodes.length} pages · {edges.length} links · {data.broken} broken
			<span class="graph-legend"><i class="dot dot--thinking"></i>thinking <i class="dot dot--post"></i>posts</span>
		</p>
	</section>
	<div class="graph-stage">
		<canvas id="wiki-graph" aria-label="双链关系图"></canvas>
		<div class="graph-tip" id="graph-tip" hidden></div>
	</div>
</MainGridLayout>

<script type="application/json" id="wiki-data" set:html={JSON.stringify(data)}></script>

<script>
	import { initWikiGraph } from "@utils/wiki-graph-runtime";

	const el = document.getElementById("wiki-data");
	if (el) {
		initWikiGraph(document.getElementById("wiki-graph") as HTMLCanvasElement, JSON.parse(el.textContent || "{}"));
	}
</script>

<style>
	.graph-head h1 { font: var(--m3e-type-headline-medium); margin: 0 0 0.5rem; }
	.graph-meta { font: var(--m3e-type-label-medium); color: var(--on-surface-variant); margin: 0 0 1rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
	.graph-legend { display: inline-flex; align-items: center; gap: 0.35rem; }
	.dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; display: inline-block; }
	.dot--thinking { background: #8b9bff; }
	.dot--post { background: #4fd1c5; }
	.graph-stage {
		position: relative;
		height: min(72vh, 640px);
		border-radius: var(--shape-corner-l);
		background: color-mix(in oklab, var(--surface-container-low) 82%, transparent);
		overflow: hidden;
	}
	#wiki-graph { width: 100%; height: 100%; display: block; cursor: grab; }
	#wiki-graph:active { cursor: grabbing; }
	.graph-tip {
		position: absolute;
		pointer-events: none;
		padding: 0.25rem 0.6rem;
		border-radius: var(--shape-corner-s);
		background: var(--surface-container-highest);
		color: var(--on-surface);
		font: var(--m3e-type-label-medium);
		box-shadow: var(--m3e-elevation-2);
		transform: translate(-50%, -140%);
		white-space: nowrap;
	}
</style>
